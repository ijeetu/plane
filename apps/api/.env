# Backend
DEBUG=0

# CORS: allow your production frontend
CORS_ALLOWED_ORIGINS="https://app.vishwalabs.com"

# Database Settings (same as your Docker service names)
POSTGRES_USER="plane"
POSTGRES_PASSWORD="plane"
POSTGRES_HOST="plane-db"
POSTGRES_DB="plane"
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Redis Settings
REDIS_HOST="plane-redis"
REDIS_PORT="6379"
REDIS_URL="redis://${REDIS_HOST}:6379/"

# RabbitMQ Settings
RABBITMQ_HOST="plane-mq"
RABBITMQ_PORT="5672"
RABBITMQ_USER="plane"
RABBITMQ_PASSWORD="plane"
RABBITMQ_VHOST="plane"

# AWS / MinIO (internal to your Docker network)
AWS_REGION=""
AWS_ACCESS_KEY_ID="access-key"
AWS_SECRET_ACCESS_KEY="secret-key"
AWS_S3_ENDPOINT_URL="http://plane-minio:9000"  # or keep localhost if that's how your compose is wired
AWS_S3_BUCKET_NAME="uploads"
FILE_SIZE_LIMIT=5242880

DOCKERIZED=1
USE_MINIO=1  # set to 1 if you're actually using the bundled MinIO

# Public URL for email links, etc.
WEB_URL="https://app.vishwalabs.com"

# Gunicorn Workers
GUNICORN_WORKERS=2

# Base URLs (all on app.vishwalabs.com, different paths)
ADMIN_BASE_URL="https://app.vishwalabs.com"
ADMIN_BASE_PATH="/god-mode"

SPACE_BASE_URL="https://app.vishwalabs.com"
SPACE_BASE_PATH="/spaces"

APP_BASE_URL="https://app.vishwalabs.com"
APP_BASE_PATH=""

LIVE_BASE_URL="https://app.vishwalabs.com"
LIVE_BASE_PATH="/live"

# Live server secret
LIVE_SERVER_SECRET_KEY="change-this-to-a-long-random-secret"

# Retention
HARD_DELETE_AFTER_DAYS=60

# MinIO SSL (0 = http, 1 = https between backend and MinIO)
MINIO_ENDPOINT_SSL=0   # change to 1 only if MinIO itself is behind https

# API key rate limit
API_KEY_RATE_LIMIT="60/minute"
